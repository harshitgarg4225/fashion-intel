# Image generation (cutouts, modeled photos, outfit renders) always uses OpenAI gpt-image.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Optional: run garment detection and the outfit stylist on Claude instead of OpenAI.
# If ANTHROPIC_API_KEY is set, the stylist defaults to Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Force a stylist provider explicitly: openai | anthropic | gemini
# (gemini lets the ENTIRE stack — detection, styling, rendering — run on one
# Google key: set WARDROBE_IMAGE_PROVIDER=gemini too and skip OpenAI entirely)
WARDROBE_STYLIST_PROVIDER=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google Photos import via the official Picker API.
# Create an OAuth client (type: Web application) in Google Cloud Console,
# enable the Photos Picker API, and add http://localhost:5173/api/google/callback
# as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Face filter: with a model reference photo present, imports only keep clothes
# worn by you (or shown unworn). Set to "off" to import everything.
WARDROBE_FACE_FILTER=on

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png

# The app binds to 127.0.0.1 by default. Set 0.0.0.0 to open it to your LAN
# (e.g. to use it from your phone) — only do this on a network you trust.
WARDROBE_HOST=

# Optional spend controls: hard-stop image generation when today's estimated
# spend (see the studio's cost meter) would exceed this many USD.
WARDROBE_DAILY_BUDGET=

# Visual curation sends garment thumbnails to the stylist for texture-aware
# styling. auto = on for closets of 20 pieces or fewer. Options: auto | on | off
WARDROBE_VISUAL_STYLIST=auto

# Image renderer: openai (gpt-image, default), gemini (needs GEMINI_API_KEY),
# or fal (needs FAL_API_KEY — the cheapest path, ~$0.03/render).
WARDROBE_IMAGE_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# fal.ai hosts open-weight editing models (ByteDance Seedream, Qwen-Image-Edit)
# on US infrastructure. Any fal model that accepts prompt + image_urls works.
FAL_API_KEY=
FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v4/edit

# REQUIRED for any public deployment (e.g. Railway): gates every /api route
# behind a passphrase and encrypts the Google token at rest.
WARDROBE_PASSPHRASE=

# Season logic for the stylist and capsule planner: north | south
WARDROBE_HEMISPHERE=north

# Where the "Get dressed by Mira" button on public share pages points.
WARDROBE_ABOUT_URL=

# ── Multi-tenant (hosted) mode ────────────────────────────────────────────
# Turns Mira into a hosted product: Google sign-in, one private closet per
# user under data/users/<id>/, and per-user render credits. The operator's
# env API keys serve everyone; the in-app keys screen is disabled.
MIRA_MULTI_TENANT=false
# Required in multi-tenant mode: >=16 chars, signs session cookies.
MIRA_SESSION_SECRET=
# Render credits granted to each new user (lifetime image generations).
MIRA_FREE_RENDERS=25
# Referral rewards, granted when an invited user completes their FIRST
# successful render: the inviter earns MIRA_REFERRAL_BONUS credits, the
# invited user earns MIRA_REFERRED_BONUS on top of their free allowance.
MIRA_REFERRAL_BONUS=10
MIRA_REFERRED_BONUS=5
# Google SSO reuses GOOGLE_CLIENT_ID/SECRET above; add BOTH redirect URIs
# to the OAuth client: .../api/google/callback and .../auth/google/callback

# ── Payments & compliance (multi-tenant) ─────────────────────────────────
# Razorpay credit packs. Also set the webhook (payment.captured) to
# https://YOUR-DOMAIN/api/billing/webhook with RAZORPAY_WEBHOOK_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shown on the public legal pages (/legal/terms, privacy, refunds,
# pricing, contact) — required for Razorpay activation.
MIRA_OPERATOR_NAME=
MIRA_SUPPORT_EMAIL=
